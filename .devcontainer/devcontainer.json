{
  "name": "Automated Flipping",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "FlipLab Dashboard",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "npm install && npm run setup:scraper",
  "postStartCommand": "bash -lc 'nohup npm start > /tmp/automated-flipping.log 2>&1 &'",
  "remoteEnv": {
    "PORT": "3000"
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"]
    }
  }
}
